# =============================================================================
# JUST MONEY — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values as you get them.
# Anything marked [REQUIRED] blocks a feature. [OPTIONAL] enhances it.
# All values come from the user doing the signup, then pasted here.
# =============================================================================

# ---- IMAGES (Required for cover art + mockups) -----------------------------
# Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# ---- NOTION (Required to build real Notion templates) -----------------------
# Sign up: https://www.notion.so/my-integrations → New integration
# Share each target Notion page with the integration first
NOTION_API_KEY=secret_replace-me
NOTION_DEFAULT_PARENT_PAGE_ID=replace-me-with-notion-page-uuid

# ---- CANVA (Optional - for real Canva templates) ---------------------------
# Sign up: https://www.canva.com/developers/integrations
CANVA_CLIENT_ID=replace-me
CANVA_CLIENT_SECRET=replace-me

# ---- GOOGLE SHEETS (Optional - for live Google Sheets) ----------------------
# https://console.cloud.google.com → enable Sheets API → create OAuth client
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ---- MARKETPLACES ----------------------------------------------------------
# Etsy: open shop at https://www.etsy.com/sell → apply for API at developer.etsy.com
# Etsy API access takes 1-3 days; first listings are manual
ETSY_API_KEY=replace-me
ETSY_SHOP_ID=replace-me
ETSY_ACCESS_TOKEN=replace-me
ETSY_REFRESH_TOKEN=replace-me

# Gumroad: https://gumroad.com/settings/developer → Create personal access token
GUMROAD_PERSONAL_ACCESS_TOKEN=replace-me

# ---- PAYMENTS (Stripe for own-site sales) -----------------------------------
# Sign up: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ---- HOSTING + DATABASE ----------------------------------------------------
# Vercel: https://vercel.com/account/tokens
VERCEL_TOKEN=replace-me
VERCEL_TEAM_ID=optional-replace-me
VERCEL_PROJECT_ID=replace-me-after-first-deploy

# Supabase: https://app.supabase.com/account/tokens + project URL
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.replace-me.supabase.co:5432/postgres

# ---- TRAFFIC (Optional) ----------------------------------------------------
# Pinterest: https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=replace-me
PINTEREST_BOARD_ID=replace-me

# X / Twitter: https://developer.twitter.com/en/portal
X_API_KEY=replace-me
X_API_SECRET=replace-me
X_ACCESS_TOKEN=replace-me
X_ACCESS_SECRET=replace-me

# ---- NOTIFICATIONS ---------------------------------------------------------
# Where I should ping you when things happen
NOTIFY_WEBHOOK_URL=optional-discord-or-slack-webhook
NOTIFY_EMAIL=optional-your-email
